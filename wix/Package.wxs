<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package
        Name="patram"
        Manufacturer="Abhinav Gunwant"
        Version="0.0.1"
        UpgradeCode="7ef94eb9-a807-4e69-b8e2-a86efd283e29">

        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="DesktopFolder">
            <Component Id="PatramShortcutComponent">
                <Shortcut
                    Id="PatramDesktopShortcut"
                    Name="patram"
                    Description="Launch patram"
                    Target="[PATRAMINSTALLDIR]patram.exe"
                    WorkingDirectory="PATRAMINSTALLDIR" />
                <RegistryValue
                    Root="HKCU"
                    Key="Software\AbhinavGunwant\Patram"
                    Name="installed"
                    Type="integer"
                    Value="1"
                    KeyPath="yes" />
            </Component>
        </StandardDirectory>

        <StandardDirectory Id="ProgramFilesFolder">
            <Directory Id="AbhinavGunwant" Name="AbhinavGunwant">
                <Directory Id="PATRAMINSTALLDIR" Name="patram">
                    <File Source="../LICENSE" />
                    <File Source="../core/Debug/patram.exe" />
                    <File Source="../core/Debug/freetype.dll" />

                    <Directory Name="assets">
                        <Directory Name="fonts">
                            <Directory Name="poppins">
                                <File Source="../assets/fonts/poppins/Poppins-Regular.ttf" />
                                <File Source="../assets/fonts/poppins/OFL.txt" />
                            </Directory>
                        </Directory>

                        <Directory Name="images">
                            <File Source="../assets/images/file.png" />
                            <File Source="../assets/images/plus.png" />
                            <File Source="../assets/images/LICENSE" />
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
        </StandardDirectory>
    </Package>
</Wix>

